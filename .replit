modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Python Analyzer (Flask)"

[[workflows.workflow]]
name = "Python Analyzer (Flask)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd python-analyzer && python3 app.py 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 10000
externalPort = 6000

[[ports]]
localPort = 25882
externalPort = 3000

[[ports]]
localPort = 25883
externalPort = 3002

[[ports]]
localPort = 25884
externalPort = 5173

[nix]
channel = "stable-25_05"
